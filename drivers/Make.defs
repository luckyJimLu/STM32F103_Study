# ==============================================================================
# drivers/Make.defs - Drivers & CMSIS Build Definitions
# ==============================================================================

INCDIRS += $(TOPDIR)/drivers/CMSIS/Core/Include
INCDIRS += $(TOPDIR)/drivers/CMSIS/Device/ST/STM32F1xx/Include
INCDIRS += $(TOPDIR)/drivers/STM32F1xx_HAL_Driver/Inc
INCDIRS += $(TOPDIR)/drivers/STM32F1xx_HAL_Driver/Inc/Legacy

# CMSIS System Source
CSRCS += drivers/CMSIS/Device/ST/STM32F1xx/Source/Templates/system_stm32f1xx.c

# Startup Assembly
ifeq ($(CONFIG_CHIP_STM32F103ZE),y)
ASRCS += drivers/CMSIS/Device/ST/STM32F1xx/Source/Templates/gcc/startup_stm32f103xe.s
else
ASRCS += drivers/CMSIS/Device/ST/STM32F1xx/Source/Templates/gcc/startup_stm32f103xb.s
endif

# HAL Drivers
ifeq ($(CONFIG_DRIVER_USE_HAL),y)
CSRCS += drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal.c
CSRCS += drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_rcc.c
CSRCS += drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_gpio.c
CSRCS += drivers/STM32F1xx_HAL_Driver/Src/stm32f1xx_hal_uart.c
endif
