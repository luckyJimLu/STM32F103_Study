#
CONFIG_BSP_USING_LED=y
CONFIG_BSP_USING_KEY=y
CONFIG_BSP_USING_USART1=y
CONFIG_BSP_USART1_BAUDRATE=115200
# end of Board Support Package (BSP) Configuration

#
# Drivers & HAL Configuration
#
CONFIG_DRIVER_USE_HAL=y
CONFIG_DRIVER_HAL_GPIO=y
CONFIG_DRIVER_HAL_UART=y
CONFIG_DRIVER_HAL_RCC=y
