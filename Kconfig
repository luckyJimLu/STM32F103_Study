mainmenu "STM32F103 Embedded System Configuration"

menu "Target Chip & Architecture Configuration"

choice
    prompt "Target STM32F103 Chip Model"
    default CHIP_STM32F103CB
    help
        Select target STM32F103 microcontroller model.

config CHIP_STM32F103CB
    bool "STM32F103C8/CB (Medium Density, 64KB/128KB Flash, 20KB RAM)"
    select ARCH_ARM_CORTEX_M3

config CHIP_STM32F103ZE
    bool "STM32F103ZE (High Density, 512KB Flash, 64KB RAM)"
    select ARCH_ARM_CORTEX_M3

endchoice

config ARCH_ARM_CORTEX_M3
    bool
    default y

config SYS_CLOCK_FREQ_HZ
    int "System Core Clock Frequency (Hz)"
    default 72000000
    help
        System Core Clock Frequency in Hz (Default 72MHz).

config HSE_VALUE_HZ
    int "External High Speed Oscillator (HSE) Frequency (Hz)"
    default 8000000
    help
        External Crystal Oscillator Frequency in Hz (Default 8MHz).

endmenu

menu "Operating System (RTOS) Selection"

choice
    prompt "RTOS Mode"
    default RTOS_NONE
    help
        Select real-time operating system kernel or bare-metal mode.

config RTOS_NONE
    bool "Bare-metal (No RTOS)"
    help
        Run application in bare-metal super-loop.

config RTOS_RTTHREAD
    bool "RT-Thread Nano"
    help
        Enable RT-Thread Nano lightweight real-time kernel.

config RTOS_FREERTOS
    bool "FreeRTOS"
    help
        Enable FreeRTOS real-time kernel.

endchoice

endmenu

source "app/Kconfig"
source "bsp/Kconfig"
source "drivers/Kconfig"
source "middlewares/Kconfig"
source "third_party/Kconfig"
