mainmenu "STM32F103 Product and System Configuration"

source "product/Kconfig"

menu "Operating System (RTOS) Selection"

choice
    prompt "RTOS Mode"
    default RTOS_NONE
    help
        Select real-time operating system kernel or bare-metal mode.

config RTOS_NONE
    bool "Bare-metal (No RTOS)"
    help
        Run application in bare-metal super-loop.

config RTOS_RTTHREAD
    bool "RT-Thread Nano"
    help
        Enable RT-Thread Nano lightweight real-time kernel.

config RTOS_FREERTOS
    bool "FreeRTOS"
    help
        Enable FreeRTOS real-time kernel.

endchoice

endmenu

source "app/Kconfig"
source "bsp/Kconfig"
source "drivers/Kconfig"
source "middlewares/Kconfig"
