# ==============================================================================
# middlewares/third_party/Make.defs - Third Party Build Definitions
# ==============================================================================

CSRCS += middlewares/third_party/dummy_third_party.c

ifeq ($(CONFIG_USING_CJSON),y)
INCDIRS += $(TOPDIR)/middlewares/third_party/cJSON
CSRCS   += middlewares/third_party/cJSON/cJSON.c
endif

ifeq ($(CONFIG_USING_SEGGER_RTT),y)
INCDIRS += $(TOPDIR)/middlewares/third_party/SEGGER_RTT
CSRCS   += $(wildcard $(TOPDIR)/middlewares/third_party/SEGGER_RTT/*.c)
endif
