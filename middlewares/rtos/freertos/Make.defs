# ==============================================================================
# FreeRTOS Make.defs — V202112.00 GCC ARM_CM3
# ==============================================================================

# Include paths
INCDIRS += $(TOPDIR)/middlewares/rtos/freertos
INCDIRS += $(TOPDIR)/middlewares/rtos/freertos/include
INCDIRS += $(TOPDIR)/middlewares/rtos/freertos/portable/GCC/ARM_CM3

# Kernel sources
CSRCS += middlewares/rtos/freertos/src/tasks.c
CSRCS += middlewares/rtos/freertos/src/queue.c
CSRCS += middlewares/rtos/freertos/src/list.c
CSRCS += middlewares/rtos/freertos/src/timers.c
CSRCS += middlewares/rtos/freertos/src/event_groups.c
CSRCS += middlewares/rtos/freertos/src/stream_buffer.c

# Portable layer
CSRCS += middlewares/rtos/freertos/portable/GCC/ARM_CM3/port.c
CSRCS += middlewares/rtos/freertos/portable/MemMang/heap_4.c
