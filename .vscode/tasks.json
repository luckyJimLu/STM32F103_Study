{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build active menuconfig",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\build.bat",
      "args": ["configured-debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build all product/system images",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\build.bat",
      "args": ["all"],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Kconfig menuconfig",
      "type": "shell",
      "command": "python scripts/menuconfig.py",
      "problemMatcher": []
    },
    {
      "label": "Flash active configuration",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\flash.bat",
      "args": ["configured-debug", "STM32F103ZE"],
      "dependsOn": "Build active menuconfig",
      "problemMatcher": []
    },
    {
      "label": "Clean all builds",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\clean.bat",
      "args": ["all"],
      "problemMatcher": []
    }
  ]
}
