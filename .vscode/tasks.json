{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Baremetal (Ninja)",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\build.bat",
      "args": ["baremetal-debug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build RT-Thread (Ninja)",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\build.bat",
      "args": ["rtt-debug"],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build FreeRTOS (Ninja)",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\build.bat",
      "args": ["freertos-debug"],
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Clean All Builds",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\clean.bat",
      "args": ["all"],
      "problemMatcher": []
    },
    {
      "label": "Kconfig Menuconfig",
      "type": "shell",
      "command": "python scripts/menuconfig.py",
      "problemMatcher": []
    },
    {
      "label": "Kconfig GUI Config",
      "type": "shell",
      "command": "python scripts/menuconfig.py --gui",
      "problemMatcher": []
    },
    {
      "label": "Flash via ST-Link",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/flash.bat",
      "dependsOn": "Build Baremetal (Ninja)",
      "problemMatcher": []
    }
  ]
}
