      "runToEntryPoint": "main",
      "preLaunchTask": "Build active menuconfig"
    },
    {
      "name": "Debug active config as ALIENTEK F103ZE",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/out/configured-debug/STM32F103_Study.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "device": "STM32F103ZE",
      "configFiles": ["${workspaceFolder}/scripts/openocd_stlink.cfg"],
      "runToEntryPoint": "main",
      "preLaunchTask": "Build active menuconfig"
    }
  ]
}
