{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug active config as BluePill C8",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/out/configured-debug/STM32F103_Study.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "device": "STM32F103C8",
