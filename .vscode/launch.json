{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ALIENTEK STM32F103ZE (J-Link SWD)",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/out/configured-debug/STM32F103_Study.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "jlink",
      "device": "STM32F103ZE",
      "interface": "swd",
      "gdbPath": "${workspaceFolder}/tools/toolchain/bin/arm-none-eabi-gdb.exe",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build active menuconfig"
    }
  ]
}
