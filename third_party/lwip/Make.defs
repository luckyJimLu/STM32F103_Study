# ==============================================================================
# third_party/lwip/Make.defs
# ==============================================================================

INCDIRS += $(TOPDIR)/third_party/lwip/arch
INCDIRS += $(TOPDIR)/third_party/lwip/src/include
INCDIRS += $(TOPDIR)/third_party/lwip/src/include/lwip

CSRCS   += $(wildcard $(TOPDIR)/third_party/lwip/src/core/*.c)
CSRCS   += $(wildcard $(TOPDIR)/third_party/lwip/src/core/ipv4/*.c)
CSRCS   += $(wildcard $(TOPDIR)/third_party/lwip/src/api/*.c)
CSRCS   += $(wildcard $(TOPDIR)/third_party/lwip/src/netif/*.c)
